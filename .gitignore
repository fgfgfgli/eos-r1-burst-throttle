*.jsonl
*.log
*backup*/
_entries.csv
*.csv
*.saz
*.pcap
*.pcapng

# ---- 密钥与凭据 -----------------------------------------------------------
*keys*.json
*key_candidate*.json
key-*.json
*.pem
*.key
*.pfx
